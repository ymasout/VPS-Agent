{$CONTROL_PLANE_DOMAIN} {
	encode zstd gzip

	# GitHub App Webhook 不使用控制台 Basic Auth，只接受应用层 HMAC-SHA256 验签。
	@github_webhook path /api/v1/github/webhooks
	handle @github_webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			header_up -X-VPS-Agent-Principal-Id
			header_up -X-VPS-Agent-Principal-Source
			header_up -X-VPS-Agent-Principal-Proxy-Token
			header_up -X-VPS-Agent-Principal-Write-Token
		}
	}

	# Agent 只通过自身的一次性注册令牌或 Bearer 凭证认证。
	@agent_api path /api/v1/agents/register /api/v1/agents/report /api/v1/agents/evidence-requests/* /api/v1/agents/operations/* /agent-downloads/* /healthz
	handle @agent_api {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			header_up -X-VPS-Agent-Principal-Id
			header_up -X-VPS-Agent-Principal-Source
			header_up -X-VPS-Agent-Principal-Proxy-Token
			header_up -X-VPS-Agent-Principal-Write-Token
		}
	}

	# M6.4c1 only observes trusted write identity. Existing API admin authorization remains authoritative.
	@principal_write {
		method POST
		path_regexp principal_write_path ^/api/v1/(operations|deployment-plans|deployment-operations|deployment-operations/[^/]+/rollback|operations/[^/]+/confirm|events/[^/]+/conversation/turns/[^/]+/(restart|rollback)-plan)$
	}
	handle @principal_write {
		basic_auth {
			{$CADDY_ADMIN_USER} {$CADDY_ADMIN_PASSWORD_HASH}
			{$CADDY_OPERATOR_USER} {$CADDY_OPERATOR_PASSWORD_HASH}
			{$CADDY_APPROVER_USER} {$CADDY_APPROVER_PASSWORD_HASH}
		}
		reverse_proxy api:8000 {
			header_up X-VPS-Agent-Principal-Id {http.auth.user.id}
			header_up X-VPS-Agent-Principal-Source caddy_basic
			header_up X-VPS-Agent-Principal-Proxy-Token {$PRINCIPAL_PROXY_TOKEN}
			header_up X-VPS-Agent-Principal-Write-Token {$PRINCIPAL_WRITE_PROXY_TOKEN}
		}
	}

	# 管理 API 和 API 文档需要额外的控制台登录保护。
	@control_api path /api/* /docs* /openapi.json
	handle @control_api {
		basic_auth {
			{$CADDY_ADMIN_USER} {$CADDY_ADMIN_PASSWORD_HASH}
			{$CADDY_OPERATOR_USER} {$CADDY_OPERATOR_PASSWORD_HASH}
			{$CADDY_APPROVER_USER} {$CADDY_APPROVER_PASSWORD_HASH}
		}
		reverse_proxy api:8000 {
			header_up X-VPS-Agent-Principal-Id {http.auth.user.id}
			header_up X-VPS-Agent-Principal-Source caddy_basic
			header_up X-VPS-Agent-Principal-Proxy-Token {$PRINCIPAL_PROXY_TOKEN}
			header_up -X-VPS-Agent-Principal-Write-Token
		}
	}

	# Web 控制台需要登录；页面在服务端通过内部网络读取 API。
	handle {
		basic_auth {
			{$CADDY_ADMIN_USER} {$CADDY_ADMIN_PASSWORD_HASH}
			{$CADDY_OPERATOR_USER} {$CADDY_OPERATOR_PASSWORD_HASH}
			{$CADDY_APPROVER_USER} {$CADDY_APPROVER_PASSWORD_HASH}
		}
		reverse_proxy web:3000 {
			header_up X-VPS-Agent-Principal-Id {http.auth.user.id}
			header_up X-VPS-Agent-Principal-Source caddy_basic
			header_up X-VPS-Agent-Principal-Proxy-Token {$PRINCIPAL_PROXY_TOKEN}
			header_up -X-VPS-Agent-Principal-Write-Token
		}
	}
}
